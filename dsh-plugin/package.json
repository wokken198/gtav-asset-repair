{
  "name": "dsh-gta-tools",
  "version": "0.6.0",
  "description": "GTA V texture toolkit for Enhanced & Legacy: badge normal maps, YTD shrink, mip fill, ped YMT check/repair",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "vendor",
    "resources/pack_ytd.ps1",
    "README.md",
    "resources/ytd_inspect.ps1"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gta5",
    "gta",
    "normal-map",
    "dds",
    "ytd"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wokken198/gtav-toolkit.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/wokken198/gtav-toolkit"
}
